{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "cabeus-explorer",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-07-06",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1
        }
    }
}
